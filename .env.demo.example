# ngrok 대시보드에서 발급한 값입니다. 파일명은 .env.demo로 복사해 사용하세요.
NGROK_AUTHTOKEN=replace-with-ngrok-authtoken
NGROK_DOMAIN=replace-with-your-domain.ngrok-free.app

# 시연용 데이터베이스와 관리자 계정입니다. 반드시 새 강력한 값으로 바꾸세요.
DB_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=demo-admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
QUOTE_RECIPIENT=estimate@kumsungenc.co.kr
SUPPORT_RECIPIENT=B2B@kumsungenc.co.kr
SUPPORT_EMAIL=B2B@kumsungenc.co.kr
PRIVACY_VERSION=2026-07-28

# Google Apps Script 웹앱 배포 후 URL과 임의의 긴 비밀값을 설정합니다.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret
TOSS_SECRET_KEY=
SHOP_ADMIN_ACCESS_PASSWORD=change-this-shop-admin-password

# 기본값은 로컬 Mailpit입니다. 메일은 http://localhost:8025 에서 확인합니다.
MAIL_PROVIDER=MAILPIT
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=demo
MAIL_PASSWORD=
MAIL_PASSWORD_FILE=/run/secrets/mail_password
MAIL_FROM=no-reply@kumsungenc.co.kr
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL=false

DEMO_PORT=8088
MAILPIT_PORT=8025
NGROK_INSPECT_PORT=4040
