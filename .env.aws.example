# 공개 홈페이지/CloudFront 도메인과 EC2 원본 도메인을 분리합니다.
PUBLIC_DOMAIN=kumsungenc.co.kr
ORIGIN_DOMAIN=origin.kumsungenc.co.kr

AWS_REGION=ap-northeast-2
S3_BUCKET=kumsungenc-production-files-CHANGE-ME
S3_PREFIX=private

# RDS 엔드포인트는 AWS 콘솔에서 복사합니다. 비밀번호는 이 파일이 아니라 .secrets/db_password에 둡니다.
DB_URL=jdbc:postgresql://CHANGE-ME.ap-northeast-2.rds.amazonaws.com:5432/kumsung_enc?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem
DB_USERNAME=kumsung_app
DB_PASSWORD_SECRET_FILE=./.secrets/db_password
DB_POOL_MAX=10
DB_POOL_MIN=2

MAIL_PROVIDER=GOOGLE_WORKSPACE
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=B2B@kumsungenc.co.kr
MAIL_PASSWORD_SECRET_FILE=./.secrets/mail_password
MAIL_FROM=B2B@kumsungenc.co.kr
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL=false

QUOTE_RECIPIENT=B2B@kumsungenc.co.kr
SUPPORT_RECIPIENT=B2B@kumsungenc.co.kr
SUPPORT_EMAIL=B2B@kumsungenc.co.kr

# 최초 관리자 생성 때만 채우고 첫 로그인 후 비웁니다.
ADMIN_EMAIL=
ADMIN_PASSWORD_SECRET_FILE=./.secrets/admin_password

# 네이버 개발자센터 Callback URL: https://${PUBLIC_DOMAIN}/login/oauth2/code/naver
NAVER_LOGIN_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

EMAIL_OUTBOX_POLL_MS=1000
EMAIL_OUTBOX_BATCH_SIZE=10
GOOGLE_SHEETS_ENABLED=false
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY_SECRET_FILE=./.secrets/toss_secret_key
PRIVACY_VERSION=2026-07-28
INQUIRY_RETENTION_DAYS=1095
SHEET_OUTBOX_RETENTION_DAYS=1095
