# scripts/local-up.ps1 전용 로컬 개발 설정입니다.
# 필요할 때 이 파일을 .env.local로 복사한 뒤 값을 변경하세요.
SERVER_PORT=8080
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DB_PASSWORD=kumsung_dev_password
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=local-admin-1234

APP_BASE_URL=http://localhost:8080
NAVER_LOGIN_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MAIL_FROM=system@localhost
QUOTE_RECIPIENT=estimate@localhost.test
SUPPORT_RECIPIENT=support@localhost.test
SUPPORT_EMAIL=support@localhost.test

# 테스트 모듈을 활성화할 때만 본인의 토스페이먼츠 테스트 시크릿 키를 설정하세요.
# 현재 결제창 payment() 연동에는 같은 MID의 API 개별 연동 키 세트를 사용하세요.
TOSS_CLIENT_KEY=test_ck_replace_with_your_test_client
# 토스페이먼츠 테스트 시크릿 키. 실제 값은 .env.local에만 입력하세요.
TOSS_SECRET_KEY=test_sk_replace_with_your_test_secret
