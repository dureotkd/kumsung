DOMAIN=estimate.your-company-domain.example
DB_PASSWORD=replace-with-a-long-random-password
# 홈페이지 도메인 메일 호스팅 가입 후 제공받은 SMTP 정보를 입력합니다.
MAIL_PROVIDER=CUSTOM
MAIL_HOST=smtp.your-mail-provider.example
MAIL_PORT=587
MAIL_USERNAME=no-reply@your-company-domain.example
MAIL_PASSWORD=
MAIL_PASSWORD_FILE=/run/secrets/mail_password
MAIL_PASSWORD_SECRET_FILE=./.secrets/mail_password
MAIL_FROM=no-reply@your-company-domain.example
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL=false
QUOTE_RECIPIENT=estimate@your-company-domain.example
SUPPORT_RECIPIENT=B2B@kumsungenc.co.kr
SUPPORT_EMAIL=B2B@kumsungenc.co.kr
# 아래 두 값은 최초 최고관리자 생성 및 첫 로그인 확인 후 비웁니다.
ADMIN_EMAIL=admin@your-company-domain.example
ADMIN_PASSWORD=replace-with-at-least-12-characters
EMAIL_OUTBOX_POLL_MS=1000
EMAIL_OUTBOX_BATCH_SIZE=10
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret
PRIVACY_VERSION=2026-07-28
INQUIRY_RETENTION_DAYS=1095
SHEET_OUTBOX_RETENTION_DAYS=1095
BACKUP_RETENTION_DAYS=30
